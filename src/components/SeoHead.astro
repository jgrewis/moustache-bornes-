---
import { site } from '../data/site.js';

interface Props {
  title: string;
  description?: string;
  path?: string;
  image?: string;
}

const {
  title,
  description = site.description,
  path = '',
  // Pas d'image OG dédiée pour l'instant : on retombe sur le favicon SVG
  // (existe réellement dans /public/). Évite une 404 lors du partage social.
  // TODO : produire une image og-image.jpg 1200×630 et la déposer dans /public/.
  image = '/favicon.svg',
} = Astro.props;

const pageTitle = title === site.name ? `${site.name} — ${site.tagline}` : `${title} · ${site.name}`;
const canonical = new URL(path, Astro.site ?? 'https://moustache-bornes.fr').toString();
const ogImage = new URL(image, Astro.site ?? 'https://moustache-bornes.fr').toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  description: site.description,
  areaServed: site.zone,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Mulhouse',
    addressRegion: 'Grand Est',
    addressCountry: 'FR',
  },
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<!-- Fallback de sécurité côté HTML. Les vrais en-têtes HTTP sont configurés
     dans /public/_headers et /netlify.toml (CSP, X-Frame-Options, HSTS…). -->
<meta http-equiv="X-Content-Type-Options" content="nosniff" />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<meta name="robots" content="index, follow" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="theme-color" content="#FAF7F2" />

<meta property="og:type" content="website" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content="fr_FR" />
<meta property="og:site_name" content={site.name} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<!-- Polices Google avec `display=swap` : le navigateur affiche immédiatement la
     police fallback et bascule dès que la police custom est prête (pas de FOIT).
     Pas de hack `media=print onload` ici : un handler inline serait bloqué par la
     CSP `script-src 'self'`. La requête CSS reste bloquante mais c'est un seul
     stylesheet externe — coût acceptable pour un site statique. -->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap" />

<!-- JSON-LD : on échappe </script>, < et > pour neutraliser toute injection si une valeur de site.js contenait un jour du HTML. -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026')} />
