---
interface Props {
  title?: string;
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const {
  title = "Envie d'animer votre événement ?",
  text = "Décrivez-nous votre projet : date, lieu, nombre d'invités. Devis personnalisé sous 24 h.",
  ctaLabel = "Demander mon devis",
  ctaHref = "/contact/",
} = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="cta-banner fade-in">
      <h2>{title}</h2>
      <p style="max-width: 50ch;">{text}</p>
      <a href={ctaHref} class="btn btn--accent">{ctaLabel}</a>
    </div>
  </div>
</section>
